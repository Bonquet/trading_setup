# Copy this file to config/.env and fill in your keys. Do NOT commit .env.
# goldapi.net live spot source. GoldAPI.io is kept as a legacy fallback.
GOLDAPI_NET_KEY=your_goldapi_net_key_here
QUOTE_SOURCE=auto
GOLDAPI_KEY=your_goldapi_key_here

# TwelveData — OHLC candles for XAU/USD on D1/H4/H1/M15. Sign up: https://twelvedata.com
TWELVEDATA_KEY=your_twelvedata_key_here

# --- MT5 sync (optional; for live broker state via investor passwords) ---
# Add one MT5_<NAME>_INVESTOR_PWD per account. Names match the keys in accounts.json.
# Run scripts/mt5_sync.py --discover to register new accounts; see MT5_SYNC_SETUP.md
# MT5_MAIN_INVESTOR_PWD=
# MT5_SAVINGS_INVESTOR_PWD=
